# Copy to .env and fill in as needed:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# The World Bank Indicators API is open and needs no key, so this analysis runs
# with no .env file at all. The variables below exist so that configuration and
# credentials always arrive from the environment rather than from source.

# Override the API host (e.g. to point at a mirror or a local test server).
WORLD_BANK_API_BASE=https://api.worldbank.org/v2

# Unused by the open Indicators endpoint. Kept to document where a key would go
# if this were extended to a gated source such as FRED or the IMF.
WORLD_BANK_API_KEY=
